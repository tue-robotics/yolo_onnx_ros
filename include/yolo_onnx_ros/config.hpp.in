#cmakedefine01 YOLO_ONNX_ROS_TENSORRT_ENABLED
// NOLINTEND(cppcoreguidelines-macro-to-enum,modernize-macro-to-enum)

#endif // YOLO_ONNX_ROS_CONFIG_HPP_
