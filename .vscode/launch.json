{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Yolo Model (ONNX)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/ana/yolo_onnx_ros/build/test_yolo_onnx_ros",
            "args": [
                "/home/ana/yolo_onnx_ros/models/yolo11m.onnx",
                "/home/ana/yolo_onnx_ros/images",
                "--backend=onnx"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/usr/lib/wsl/lib:${env:LD_LIBRARY_PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            //"preLaunchTask": "build-yolo-project"
        },
        {
            "name": "Debug Yolo Model (TensorRT)",
